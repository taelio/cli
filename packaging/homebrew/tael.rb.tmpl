# This formula is regenerated by the tael CLI release workflow from
# packaging/homebrew/tael.rb.tmpl in taelio/cli. Manual edits here will be
# overwritten on the next release; change the template instead.
class Tael < Formula
  desc "Command-line interface for the Tael AI DevOps platform"
  homepage "https://tael.io"
  version "__VERSION__"
  license "Apache-2.0"

  livecheck do
    url :stable
    strategy :github_latest
  end

  on_macos do
    on_arm do
      url "https://github.com/taelio/cli/releases/download/v#{version}/tael-darwin-arm64"
      sha256 "__SHA_DARWIN_ARM64__"
    end
    on_intel do
      url "https://github.com/taelio/cli/releases/download/v#{version}/tael-darwin-amd64"
      sha256 "__SHA_DARWIN_AMD64__"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/taelio/cli/releases/download/v#{version}/tael-linux-arm64"
      sha256 "__SHA_LINUX_ARM64__"
    end
    on_intel do
      url "https://github.com/taelio/cli/releases/download/v#{version}/tael-linux-amd64"
      sha256 "__SHA_LINUX_AMD64__"
    end
  end

  def install
    # Release assets are bare binaries rather than archives, so the download
    # carries no execute bit; set it before anything runs the binary.
    bin.install Dir["tael-*"].first => "tael"
    chmod 0755, bin/"tael"
    generate_completions_from_executable(bin/"tael", "completion")
  end

  test do
    assert_match "tael v#{version}", shell_output("#{bin}/tael version")
  end
end
